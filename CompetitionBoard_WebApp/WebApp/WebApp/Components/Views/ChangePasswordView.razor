@using Microsoft.Extensions.Options
@using WebApp.Configs
@using WebApp.Services.Login
@inject PasswordStore PasswordStore
@inject IOptionsMonitor<UIConfig> UIConfig

@* Nur für den Admin: ändert das Passwort der Bedienung. *@
<div class="change-password-view">
    @* Adresse mit Prüfsumme: ein geändertes Icon lädt der Browser sofort neu. *@
    <ImageButton Source="@Assets["images/key.svg"]" Size="40" Title="Passwort ändern" OnClick="Toggle" />
    @if (_isOpen)
    {
        <div class="change-password-backdrop" @onclick="Close"></div>
        <form class="change-password-popup" @onsubmit="Save">
            <div class="change-password-title">Passwort der Bedienung ändern</div>
            <label for="new-password">Neues Passwort</label>
            <input id="new-password" type="password" class="wpf-textbox" autocomplete="new-password"
                   @bind="_password" @bind:event="oninput" />
            <label for="repeated-password">Neues Passwort wiederholen</label>
            <input id="repeated-password" type="password" class="wpf-textbox" autocomplete="new-password"
                   @bind="_repeatedPassword" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="change-password-message @(_isError ? "error" : null)">@_message</div>
            }
            <div class="change-password-buttons">
                <button type="submit">Speichern</button>
                <button type="button" @onclick="Close">Schließen</button>
            </div>
        </form>
    }
</div>

@code {
    private bool _isOpen;
    private string _password;
    private string _repeatedPassword;
    private string _message;
    private bool _isError;

    private void Toggle()
    {
        if (_isOpen)
        {
            Close();
            return;
        }
        _isOpen = true;
    }

    private void Close()
    {
        _isOpen = false;
        _password = null;
        _repeatedPassword = null;
        _message = null;
    }

    private void Save()
    {
        string error = PasswordCheck.ValidateNewPassword(UIConfig.CurrentValue, _password, _repeatedPassword);
        if (error == null)
        {
            try
            {
                PasswordStore.SavePassword(_password);
            }
            catch (Exception ex)
            {
                error = $"Das Passwort konnte nicht gespeichert werden: {ex.Message}";
            }
        }

        _isError = error != null;
        _message = error ?? "Das Passwort wurde geändert.";
        _password = null;
        _repeatedPassword = null;
    }
}
